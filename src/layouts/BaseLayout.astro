---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';
import { withBase } from '../lib/posts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 記事ページは article、それ以外は website（OGP） */
  ogType?: 'website' | 'article';
  /** 記事の公開日時（OGP の article:published_time） */
  publishedTime?: Date;
  /** 記事の更新日時（OGP の article:modified_time） */
  modifiedTime?: Date;
  /** 検索結果に出す必要がないページ（ページ送りの2ページ目以降など） */
  noindex?: boolean;
  /** ページ送りの前後（rel=prev/next） */
  prevUrl?: string;
  nextUrl?: string;
  /** 構造化データ（JSON-LD）。記事ページの BlogPosting など */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  prevUrl,
  nextUrl,
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const pageDescription = description ?? SITE.description;
const feedUrl = withBase('/feed.xml');
const canonical = new URL(Astro.url.pathname, Astro.site);
const absolute = (path: string) => new URL(path, Astro.site).href;
// OGP画像は全ページ共通の1枚。scripts/generate_og_image.mjs で生成して
// public/ に置いてあるので、ビルド時に画像を作る依存を増やさずに済む。
const ogImage = absolute(withBase(SITE.ogImage));
---

<!DOCTYPE html>
<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#09090b" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {prevUrl && <link rel="prev" href={absolute(prevUrl)} />}
    {nextUrl && <link rel="next" href={absolute(nextUrl)} />}

    <!-- SNS で共有されたときにタイトルと説明が出るようにする -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.title} />
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    {
      modifiedTime && (
        <meta
          property="article:modified_time"
          content={modifiedTime.toISOString()}
        />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="alternate"
      type="application/atom+xml"
      title={SITE.title}
      href={feedUrl}
    />
    <meta name="generator" content={Astro.generator} />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
          is:inline
        />
      )
    }
  </head>
  <body>
    <Header />

    <main class="site-main">
      <slot />
    </main>

    <Footer />
  </body>
</html>
