---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostIndexSection from '../components/PostIndexSection.astro';
import { getSortedPosts, PAGE_SIZE, pagePath } from '../lib/posts';

const posts = await getSortedPosts();
const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
---

<BaseLayout nextUrl={totalPages > 1 ? pagePath(2) : undefined}>
  <PostIndexSection
    posts={posts.slice(0, PAGE_SIZE)}
    currentPage={1}
    totalPages={totalPages}
  />
</BaseLayout>
