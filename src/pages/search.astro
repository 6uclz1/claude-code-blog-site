---
// 全文検索。インデックスは Pagefind が `npm run build` の後段で dist を走査して作る
// （src/layouts/PostLayout.astro の data-pagefind-body が対象）。
// dist を経由しない `npm run dev` では /pagefind/ が無いため検索は動かない。
//
// `?q=` を付けたURLはそのまま検索結果になる（/llms.txt が案内している入口）。
// 静的サイトなのでクエリの解釈はブラウザ側 — 検索語は下のスクリプトが読む。
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import { withBase } from '../lib/posts';

const pagefindCss = withBase('/pagefind/pagefind-ui.css');
const pagefindJs = withBase('/pagefind/pagefind-ui.js');
---

<BaseLayout
  title="検索"
  description="このブログの記事を全文検索できます。"
  noindex
>
  <section class="page-section">
    <div class="page-heading">
      <h1>検索</h1>
      <p class="eyebrow">記事本文から探す</p>
    </div>

    <link rel="stylesheet" href={pagefindCss} />
    {/*
      Pagefind の Default UI は入力欄に title しか付けないため、支援技術には
      ラベルの無いフォーム部品として見える。見えるラベルをこちらで置き、
      初期化後に aria-labelledby で結びつける（下のスクリプト）。
    */}
    <div class="search-ui__wrap" role="search">
      <p class="search-ui__label" id="search-label">記事を検索</p>
      <div id="search" class="search-ui">
        <noscript>
          <p class="empty-state">
            検索にはJavaScriptが必要です。<a href={withBase('/archive/')}
              >アーカイブ</a
            >から探してください。
          </p>
        </noscript>
      </div>
    </div>

    <nav class="post-nav" aria-label="記事ナビゲーション">
      <a class="post-nav__back" href={withBase('/')}>← 記事一覧へ</a>
    </nav>
    <SiteNav />
  </section>
</BaseLayout>

<script is:inline src={pagefindJs}></script>
<script is:inline>
  // Pagefind の UI は pagefind-ui.js が読み込まれてから初期化する。
  // 開発サーバーでは /pagefind/ が存在しないので、その場合は静かに諦める。
  window.addEventListener('DOMContentLoaded', () => {
    if (typeof PagefindUI === 'undefined') {
      document.getElementById('search').innerHTML =
        '<p class="empty-state">検索インデックスが見つかりません（本番ビルドでのみ利用できます）。</p>';
      return;
    }
    // 入力欄は PagefindUI が組み立てるので、生成された後にラベルを結びつける。
    const labelInput = () => {
      const input = document.querySelector('#search input[type="text"]');
      if (!input) return false;
      input.setAttribute('aria-labelledby', 'search-label');
      return true;
    };

    const ui = new PagefindUI({
      element: '#search',
      showSubResults: true,
      showImages: false,
      excerptLength: 24,
      translations: {
        placeholder: '記事を検索',
        clear_search: 'クリア',
        load_more: 'さらに表示',
        search_label: 'このサイトを検索',
        filters_label: '絞り込み',
        zero_results: '[SEARCH_TERM] に一致する記事はありません',
        many_results: '[SEARCH_TERM] の検索結果 [COUNT] 件',
        one_result: '[SEARCH_TERM] の検索結果 1 件',
        alt_search:
          '[SEARCH_TERM] の結果はありません。[DIFFERENT_TERM] の結果を表示しています',
        search_suggestion:
          '[SEARCH_TERM] の結果はありません。別のキーワードをお試しください',
        searching: '[SEARCH_TERM] を検索中…',
      },
    });

    // 同期的に組み上がるのが普通だが、間に合わなければ現れるまで待つ
    if (!labelInput()) {
      const observer = new MutationObserver(() => {
        if (labelInput()) observer.disconnect();
      });
      observer.observe(document.getElementById('search'), {
        childList: true,
        subtree: true,
      });
    }

    // ?q=検索語 で開かれたときは、その語で検索した状態にする。
    // 入力欄の値は PagefindUI が持っているので triggerSearch に任せる。
    const initialQuery = new URLSearchParams(location.search).get('q');
    if (initialQuery) ui.triggerSearch(initialQuery);

    // 手で入力したときもURLに反映して、結果をそのまま共有できるようにする。
    // history に積むと戻るボタンが1文字ずつ戻ってしまうので replaceState を使う。
    document.getElementById('search').addEventListener('input', (event) => {
      if (event.target.type !== 'text') return;
      const url = new URL(location.href);
      if (event.target.value) url.searchParams.set('q', event.target.value);
      else url.searchParams.delete('q');
      history.replaceState(null, '', url);
    });
  });
</script>
