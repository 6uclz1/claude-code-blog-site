---
// Jekyll の paginate_path: "/page:num/" を再現する（2ページ目以降。1ページ目は "/"）
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostIndexSection from '../components/PostIndexSection.astro';
import { getSortedPosts, PAGE_SIZE, pagePath, type Post } from '../lib/posts';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getSortedPosts();
  const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));

  return Array.from({ length: totalPages - 1 }, (_, i) => {
    const num = i + 2;
    return {
      params: { num: String(num) },
      props: {
        posts: posts.slice((num - 1) * PAGE_SIZE, num * PAGE_SIZE),
        currentPage: num,
        totalPages,
      },
    };
  });
};

interface Props {
  posts: Post[];
  currentPage: number;
  totalPages: number;
}

const { posts, currentPage, totalPages } = Astro.props;
---

<BaseLayout
  title={`${currentPage}ページ目`}
  prevUrl={pagePath(currentPage - 1)}
  nextUrl={currentPage < totalPages ? pagePath(currentPage + 1) : undefined}
  noindex
>
  <PostIndexSection
    posts={posts}
    currentPage={currentPage}
    totalPages={totalPages}
    eyebrow={`${currentPage} / ${totalPages} ページ`}
  />
</BaseLayout>
