---
// Jekyll の paginate_path: "/page:num/" を再現する（2ページ目以降。1ページ目は "/"）
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import Pagination from '../components/Pagination.astro';
import { getSortedPosts, PAGE_SIZE, type Post } from '../lib/posts';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getSortedPosts();
  const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));

  return Array.from({ length: totalPages - 1 }, (_, i) => {
    const num = i + 2;
    return {
      params: { num: String(num) },
      props: {
        posts: posts.slice((num - 1) * PAGE_SIZE, num * PAGE_SIZE),
        currentPage: num,
        totalPages,
      },
    };
  });
};

interface Props {
  posts: Post[];
  currentPage: number;
  totalPages: number;
}

const { posts, currentPage, totalPages } = Astro.props;
---

<BaseLayout title={`${currentPage}ページ目`}>
  <div class="home">
    <PostList posts={posts} />
    <Pagination currentPage={currentPage} totalPages={totalPages} />
  </div>
</BaseLayout>
