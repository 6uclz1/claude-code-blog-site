{
  "name": "claude-code-blog-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4000",
    "start": "astro dev --host 0.0.0.0 --port 4000",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview --host 0.0.0.0 --port 4000",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "og": "node scripts/generate_og_image.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.1.4",
    "marked": "^18.0.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagefind": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
